digraph G { rankdir=TB; nodesep=0.9; ranksep=1.1; splines=true; dpi=130; node[shape=plaintext,fontname="Helvetica",fontsize=10]; edge[fontname="Helvetica",fontsize=9,arrowhead=none];
usuario[label=<<table border="1" cellborder="0" cellspacing="0"><tr><td bgcolor="#1f4e79"><font color="white"><b>usuario</b></font></td></tr><tr><td align="left">PK id<br align="left"/>nombre<br align="left"/>correo (único)<br align="left"/>password_hash<br align="left"/>rol<br align="left"/>activo, creado_en<br align="left"/></td></tr></table>>];
categoria[label=<<table border="1" cellborder="0" cellspacing="0"><tr><td bgcolor="#1f4e79"><font color="white"><b>categoria</b></font></td></tr><tr><td align="left">PK id<br align="left"/>nombre (único)<br align="left"/>descripcion<br align="left"/>activa<br align="left"/></td></tr></table>>];
solicitud[label=<<table border="1" cellborder="0" cellspacing="0"><tr><td bgcolor="#1f4e79"><font color="white"><b>solicitud</b></font></td></tr><tr><td align="left">PK id<br align="left"/>codigo (único)<br align="left"/>fecha_registro<br align="left"/>FK solicitante_id<br align="left"/>FK categoria_id<br align="left"/>FK responsable_id<br align="left"/>asunto, descripcion<br align="left"/>prioridad, estado<br align="left"/>solucion, fecha_resolucion<br align="left"/></td></tr></table>>];
historial[label=<<table border="1" cellborder="0" cellspacing="0"><tr><td bgcolor="#1f4e79"><font color="white"><b>historial</b></font></td></tr><tr><td align="left">PK id<br align="left"/>FK solicitud_id<br align="left"/>FK usuario_id<br align="left"/>fecha, tipo<br align="left"/>estado_anterior<br align="left"/>estado_nuevo, observacion<br align="left"/></td></tr></table>>];
notificacion[label=<<table border="1" cellborder="0" cellspacing="0"><tr><td bgcolor="#1f4e79"><font color="white"><b>notificacion</b></font></td></tr><tr><td align="left">PK id<br align="left"/>FK usuario_id<br align="left"/>FK solicitud_id<br align="left"/>mensaje, fecha, leida<br align="left"/></td></tr></table>>];
usuario->solicitud[taillabel="1",headlabel="0..*",label="registra"]; usuario->solicitud[taillabel="0..1",headlabel="0..*",label="atiende",style=dashed];
categoria->solicitud[taillabel="1",headlabel="0..*"]; solicitud->historial[taillabel="1",headlabel="1..*"]; usuario->historial[taillabel="1",headlabel="0..*"];
usuario->notificacion[taillabel="1",headlabel="0..*"]; solicitud->notificacion[taillabel="0..1",headlabel="0..*"]; }
