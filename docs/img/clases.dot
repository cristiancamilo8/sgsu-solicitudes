digraph G { rankdir=TB; dpi=130; node[shape=record,fontname="Helvetica",fontsize=9,style=filled,fillcolor="#eef3fa"]; edge[fontname="Helvetica",fontsize=8];
Usuario[label="{Usuario|id, nombre, correo, rol, activo|de_fila()}"];
Categoria[label="{Categoria|id, nombre, descripcion, activa|de_fila()}"];
